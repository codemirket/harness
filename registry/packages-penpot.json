{
  "schema_version": 1,
  "packages": [
    {
      "id": "penpot",
      "name": "Penpot local design workspace",
      "version": "2.18.3",
      "kind": "editor",
      "adapter": "penpot",
      "status": "ready",
      "reason": "macOS ARM64 services in the dedicated rootless Podman environment with real native headless Plugin API operations. Explicitly registered running Podman and native Chromium required.",
      "summary": "Create, inspect, clone/refine and export real editable local Penpot designs using an active headless Chromium session.",
      "license": "MPL-2.0; official service image dependency notices retained",
      "source": "https://github.com/penpot/penpot/tree/ff7a66f51938b2293260ea27a64e2c4e0833b5e3",
      "dependencies": [
        "nodejs",
        "chromium"
      ],
      "notices": [
        "penpot/README.md",
        "penpot/SOURCE-INVENTORY.json",
        "penpot/PENPOT-MPL.txt",
        "penpot/PLAYWRIGHT-APACHE.txt",
        "penpot/PLAYWRIGHT-NOTICE.txt",
        "penpot/FONT-OFL.txt"
      ],
      "common": [
        {
          "url": "https://registry.npmjs.org/playwright-core/-/playwright-core-1.61.1.tgz",
          "sha256": "3740bba3a3e93b4c7bd7c0f6e3c0e5f8cdce498bef13511e4d534cc99a8ce198",
          "format": "tar-gz",
          "max_download_bytes": 3604480,
          "max_unpacked_bytes": 15925248,
          "strip_prefix": "package",
          "destination": "node_modules/playwright-core"
        }
      ],
      "embedded": [
        {
          "path": "penpot/runner.mjs",
          "destination": "runner.mjs"
        },
        {
          "path": "penpot/plugin.mjs",
          "destination": "plugin.mjs"
        },
        {
          "path": "penpot/examples/field-notes.json",
          "destination": "examples/field-notes.json"
        }
      ],
      "platforms": {
        "aarch64-apple-darwin": {
          "executable": "{node}",
          "artifacts": []
        }
      },
      "launch": {
        "args": [
          "{root}/runner.mjs"
        ],
        "env": {
          "MIRKET_PENPOT_ROOT": "{root}",
          "MIRKET_CHROMIUM": "{chromium}"
        }
      },
      "tools": {
        "allowed": [
          "penpot_create",
          "penpot_inspect",
          "penpot_update",
          "penpot_export"
        ],
        "input_policy": "none"
      },
      "service": {
        "profile": "penpot",
        "images": {
          "penpot-frontend": "penpotapp/frontend@sha256:4b755d7b8dc666184cea086b25dffe3273e09df782e72b8e4eb3388624f9b28b",
          "penpot-backend": "penpotapp/backend@sha256:d5b8d69c00a9c4735c10b3612f7e3c18806f879367fa7be7f621058769cb551e",
          "penpot-exporter": "penpotapp/exporter@sha256:64d6474cad7464b082394e7aab0aa410c4709a1c5d308a3a64677a4af3d80e93",
          "penpot-postgres": "postgres@sha256:2338e3d79f75746cee7784825b6df3707a479ac8f24a36b9832aa4f16da4e81a",
          "penpot-valkey": "valkey/valkey@sha256:0e28101f7e5acb939f4e5152b09760b49ba61f278fbf10f6f1d9c45fbbd3f3c7"
        }
      }
    }
  ]
}
