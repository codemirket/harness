{
  "schema_version": 1,
  "packages": [
    {
      "id": "axe-core",
      "name": "axe-core browser accessibility",
      "version": "4.14.0",
      "kind": "editor",
      "adapter": "axe_core",
      "status": "ready",
      "reason": "Real headless browser audits on verified macOS ARM64 runtime. Other targets require native verification.",
      "summary": "Audit visible local project page states and save structured automated accessibility evidence.",
      "license": "MPL-2.0 AND Apache-2.0",
      "source": "https://github.com/dequelabs/axe-core/tree/v4.14.0",
      "dependencies": [
        "nodejs",
        "chromium"
      ],
      "notices": [
        "axe-core/README.md",
        "axe-core/LICENSE",
        "axe-core/PLAYWRIGHT-LICENSE",
        "axe-core/PLAYWRIGHT-NOTICE"
      ],
      "common": [
        {
          "url": "https://registry.npmjs.org/axe-core/-/axe-core-4.14.0.tgz",
          "sha256": "2277b0a3ef47af9b52497faa3e71598e86e0a0e5e6eb295207a5657ede4709af",
          "format": "tar-gz",
          "max_download_bytes": 1048576,
          "max_unpacked_bytes": 5242880,
          "strip_prefix": "package",
          "destination": "node_modules/axe-core"
        },
        {
          "url": "https://registry.npmjs.org/playwright-core/-/playwright-core-1.64.0-alpha-1790635538000.tgz",
          "sha256": "54ad1d38174d6ef56d1f165e52547ece8e6c24b865f2a072d9ebaacfbad1ca47",
          "format": "tar-gz",
          "max_download_bytes": 3158016,
          "max_unpacked_bytes": 13692928,
          "strip_prefix": "package",
          "destination": "node_modules/playwright-core",
          "files": []
        }
      ],
      "embedded": [
        {
          "path": "axe-core/runner.mjs",
          "destination": "runner.mjs"
        },
        {
          "path": "axe-core/report.mjs",
          "destination": "report.mjs"
        }
      ],
      "platforms": {
        "aarch64-apple-darwin": {
          "executable": "{node}"
        }
      },
      "launch": {
        "args": [
          "{root}/runner.mjs"
        ],
        "env": {
          "MIRKET_CHROMIUM": "{chromium}"
        }
      },
      "tools": {
        "allowed": [
          "accessibility_audit"
        ]
      }
    }
  ]
}
