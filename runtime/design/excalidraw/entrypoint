#!/bin/sh
set -eu
# Match the existing one-CPU service budget. Chromium otherwise sizes pools
# from the whole VM and can exhaust the unchanged 128-task cgroup limit.
first=$(sed -n 's/^Cpus_allowed_list:[[:space:]]*\([0-9][0-9]*\).*/\1/p' /proc/self/status)
test -n "$first"
exec /usr/bin/taskset -c "$first" node src/index.js
